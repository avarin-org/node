{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "import", "jsdoc", "node", "oxc", "promise", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "rules": {
    "class-methods-use-this": "allow",
    "complexity": "allow",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "func-style": ["error", "declaration"],
    "id-length": "allow",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/group-exports": "allow",
    "import/max-dependencies": "allow",
    "import/no-default-export": "allow",
    "import/no-named-export": "allow",
    "import/no-nodejs-modules": "allow",
    "import/prefer-default-export": "allow",
    "import/no-relative-parent-imports": "allow",
    "init-declarations": "allow",
    "jsdoc/require-param": ["error", { "checkSetters": false }],
    "jsdoc/require-param-type": "allow",
    "jsdoc/require-returns": ["error", { "checkGetters": false }],
    "jsdoc/require-returns-type": "allow",
    "max-classes-per-file": ["error", { "max": 1 }],
    "max-depth": "allow",
    "max-lines": "allow",
    "max-lines-per-function": "allow",
    "max-nested-callbacks": "allow",
    "max-params": "allow",
    "max-statements": "allow",
    "new-cap": ["error", { "capIsNew": false, "newIsCap": true }],
    "no-bitwise": "allow",
    "no-continue": "allow",
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "no-eq-null": "allow",
    "no-inner-declarations": ["error", "both", { "namespaces": "allow" }],
    "no-magic-numbers": "allow",
    "no-param-reassign": "allow",
    "no-ternary": "allow",
    "no-use-before-define": ["error", { "allowNamedExports": true }],
    "no-warning-comments": "allow",
    "one-var": ["error", "never"],
    "oxc/no-async-await": "allow",
    "oxc/no-optional-chaining": "allow",
    "oxc/no-rest-spread-properties": "allow",
    "prefer-const": ["error", { "destructuring": "all" }],
    "prefer-destructuring": "allow",
    "prefer-named-capture-group": "allow",
    "require-await": "allow",
    "sort-imports": ["error", { "allowSeparatedGroups": true, "ignoreDeclarationSort": true }],
    "typescript/ban-types": "allow",
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    "typescript/consistent-return": "allow",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": true,
        "fixStyle": "separate-type-imports",
        "prefer": "type-imports"
      }
    ],
    "typescript/no-empty-object-type": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-non-null-assertion": "allow",
    "typescript/no-unnecessary-condition": "allow",
    "typescript/no-unnecessary-type-parameters": "allow",
    "typescript/no-unsafe-type-assertion": "allow",
    "typescript/parameter-properties": "allow",
    "typescript/prefer-readonly-parameter-types": "allow",
    "typescript/require-await": "allow",
    "typescript/return-await": ["error", "always"],
    "typescript/strict-boolean-expressions": ["error", { "allowNullableBoolean": true }],
    "typescript/strict-void-return": "allow",
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "typescript/unified-signatures": [
      "error",
      { "ignoreDifferentlyNamedParameters": true, "ignoreOverloadsWithDifferentJSDoc": true }
    ],
    "unicorn/max-nested-calls": "allow",
    "unicorn/no-array-for-each": "allow",
    "unicorn/no-null": "allow",
    "unicorn/no-typeof-undefined": "allow",
    "unicorn/number-literal-case": "allow",
    "unicorn/prefer-array-some": "allow",
    "unicorn/prefer-number-coercion": "allow",
    "unicorn/prefer-string-slice": "allow",
    "vitest/consistent-test-filename": ["error", { "pattern": ".*\\.spec\\.ts$" }],
    "vitest/max-expects": "allow",
    "vitest/no-hooks": "allow",
    "vitest/no-importing-vitest-globals": "allow",
    "vitest/prefer-expect-assertions": "allow",
    "vitest/prefer-importing-vitest-globals": "allow",
    "vitest/prefer-lowercase-title": "allow",
    "vitest/prefer-to-be-falsy": "allow",
    "vitest/prefer-to-be-truthy": "allow",
    "vitest/require-mock-type-parameters": "allow",
    "vitest/require-test-timeout": "allow"
  },
  "overrides": [
    {
      "files": ["**/*.{spec,test}.{js,jsx,ts,tsx}"],
      "globals": {
        "afterAll": "readonly",
        "afterEach": "readonly",
        "assert": "readonly",
        "assertType": "readonly",
        "beforeAll": "readonly",
        "beforeEach": "readonly",
        "chai": "readonly",
        "describe": "readonly",
        "expect": "readonly",
        "expectTypeOf": "readonly",
        "it": "readonly",
        "onTestFailed": "readonly",
        "onTestFinished": "readonly",
        "suite": "readonly",
        "test": "readonly",
        "vi": "readonly",
        "vitest": "readonly"
      },
      "rules": {
        "import/no-namespace": "allow",
        "max-classes-per-file": "allow",
        "no-magic-numbers": "allow",
        "no-undefined": "allow",
        "promise/prefer-await-to-callbacks": "allow",
        "require-await": "allow",
        "typescript/dot-notation": "allow",
        "typescript/explicit-function-return-type": "allow",
        "typescript/no-explicit-any": "allow",
        "typescript/no-unsafe-argument": "allow",
        "typescript/no-unsafe-assignment": "allow",
        "typescript/no-unsafe-enum-assignment": "allow",
        "typescript/no-unsafe-return": "allow",
        "typescript/no-unsafe-type-assertion": "allow",
        "typescript/require-await": "allow"
      }
    }
  ],
  "env": {
    "builtin": true
  },
  "options": {
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": true,
    "typeAware": true,
    "typeCheck": true
  }
}
