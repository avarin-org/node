{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    }
  ],
  "targetDefaults": {
    "@nx/js:swc": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "inputs": ["production", "^production"],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "main": "{projectRoot}/src/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "swcrc": "{projectRoot}/.swcrc",
        "skipTypeCheck": true,
        "stripLeadingPaths": true
      }
    },
    "test": {
      "dependsOn": ["^build"]
    }
  },
  "release": {
    "changelog": {
      "projectChangelogs": {
        "createRelease": "github",
        "renderOptions": {
          "authors": false,
          "applyUsernameToAuthors": false
        }
      }
    },
    "git": {
      "commit": true,
      "commitMessage": "chore: update version [no ci]",
      "push": true,
      "stageChanges": true,
      "tag": true
    },
    "groups": {
      "miscellaneous": {
        "projects": ["@avarin/primitives"],
        "projectsRelationship": "independent"
      }
    },
    "version": {
      "conventionalCommits": true,
      "preVersionCommand": "pnpm nx run-many -t build"
    }
  },
  "nxCloudId": "6afb82cb9481d651a924c5bc"
}
