{
  "name": "@avarin/jose",
  "version": "0.0.0",
  "description": "Implementation of the works of the JOSE Work Group.",
  "keywords": [
    "algorithm",
    "encryption",
    "jose",
    "json",
    "jwa",
    "jwe",
    "jwk",
    "jwks",
    "jws",
    "jwt",
    "key",
    "keyset",
    "set",
    "signature",
    "token",
    "web"
  ],
  "homepage": "https://github.com/avarin-org/node/tree/main/packages/jose#readme",
  "bugs": {
    "url": "https://github.com/avarin-org/node/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Revensky",
    "url": "https://github.com/revensky"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/avarin-org/node.git",
    "directory": "packages/jose"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./errors": {
      "@avarin/source": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./jwa": {
      "@avarin/source": "./src/jwa/index.ts",
      "types": "./dist/jwa/index.d.ts",
      "import": "./dist/jwa/index.js",
      "default": "./dist/jwa/index.js"
    },
    "./jwk": {
      "@avarin/source": "./src/jwk/index.ts",
      "types": "./dist/jwk/index.d.ts",
      "import": "./dist/jwk/index.js",
      "default": "./dist/jwk/index.js"
    }
  },
  "dependencies": {
    "@avarin/primitives": "workspace:*",
    "@swc/helpers": "~0.5.18"
  }
}
